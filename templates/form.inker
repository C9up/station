@layout('station::layout')
<h1>{{ heading }}</h1>
<form class="st-form" method="POST" action="{{ action }}">@if(isEdit)<input type="hidden" name="_method" value="PUT">@endif@if(csrfEnabled){{ csrfField() }}@endif@each(f in fields)<div class="st-field"><label for="{{ f.fieldId }}">{{ f.label }}</label>@if(f.isCheckbox)<input id="{{ f.fieldId }}" type="checkbox" name="{{ f.name }}" value="1"@if(f.checked) checked@endif>@elseif(f.isTextarea)<textarea id="{{ f.fieldId }}" name="{{ f.name }}"@if(f.required) required@endif@if(f.hasPlaceholder) placeholder="{{ f.placeholder }}"@endif>{{ f.value }}</textarea>@else<input id="{{ f.fieldId }}" type="{{ f.inputType }}" name="{{ f.name }}" value="{{ f.value }}"@if(f.required) required@endif@if(f.hasPlaceholder) placeholder="{{ f.placeholder }}"@endif>@endif@if(f.error)<p class="st-field-error">{{ f.error }}</p>@endif</div>@endeach<div class="st-form-actions"><button type="submit">{{ submitLabel }}</button><a class="st-cancel" href="{{ cancelUrl }}">Cancel</a></div></form>
