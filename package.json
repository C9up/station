{
  "name": "@c9up/station",
  "version": "0.1.10",
  "description": "Station \u2014 admin scaffolding for the Ream framework. Declarative resource catalogue (defineResource) backing list/show/create/edit/destroy routes, audit, policies.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./provider": {
      "types": "./src/StationProvider.ts",
      "import": "./src/StationProvider.ts"
    },
    "./services/main": {
      "types": "./src/services/main.ts",
      "import": "./src/services/main.ts"
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src/ tests/",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@c9up/atlas": "^0.3.0 || ^0.4.0",
    "@c9up/inker": "^0.1.0",
    "@c9up/ream": "^0.2.0",
    "@c9up/rune": "^0.1.8",
    "@c9up/warden": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@c9up/atlas": {
      "optional": true
    },
    "@c9up/inker": {
      "optional": true
    },
    "@c9up/ream": {
      "optional": true
    },
    "@c9up/rune": {
      "optional": true
    },
    "@c9up/warden": {
      "optional": true
    }
  },
  "devDependencies": {
    "@c9up/warden": "^0.1.0",
    "@biomejs/biome": "^2.4.10",
    "@c9up/atlas": "^0.3.0 || ^0.4.0",
    "@c9up/inker": "^0.1.0",
    "@c9up/rune": "^0.1.8",
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^4.1.2",
    "reflect-metadata": "^0.2.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "@c9up/ream": "^0.2.0"
  },
  "pnpm": {
    "//": "Pin the test toolchain to the versions used in dev. Without a committed lockfile the standalone CI resolves fresh (esbuild 0.28.x / vitest 4.1.9), whose decorator transform flakes 'Invalid or unexpected token' on the decorator suites. Overrides only apply when this package is the install root (CI), so the monorepo workspace is unaffected.",
    "overrides": {
      "esbuild": "0.27.7",
      "vite": "7.3.3",
      "vitest": "4.1.6"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src",
    "templates"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./provider": {
        "types": "./dist/StationProvider.d.ts",
        "import": "./dist/StationProvider.js"
      },
      "./services/main": {
        "types": "./dist/services/main.d.ts",
        "import": "./dist/services/main.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/station.git"
  }
}
